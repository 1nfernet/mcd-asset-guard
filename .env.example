# 复制为 .env 后填入真实 Token；.env 已被 .gitignore 忽略，任何提交文件禁止出现真实 Token
MCD_MCP_TOKEN=your-token-here
MCD_MCP_ENDPOINT=https://mcd.mcd.cn

# 写操作总开关：默认锁定；设为 true 才放行 create-order / party-order-create /
# mall-create-order / draw-lottery / auto-bind-coupons / delivery-create-address
ENABLE_WRITE_ACTIONS=false

# 演示与调试
# MCD_AS_OF=2026-10-28            # 模拟日期（演示临期分级）
# MCD_RATE_LIMIT_PER_MIN=480      # 本地限速（官方上限 600，默认留 20% 余量）
# MCD_REQUEST_TIMEOUT=15
